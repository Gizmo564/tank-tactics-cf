{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tank-tactics-cf",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "tanks.0801564.xyz", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "GameDO" },
      { "name": "DIRECTORY", "class_name": "DirectoryDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameDO"] },
    { "tag": "v2", "new_sqlite_classes": ["DirectoryDO"] }
  ]
}
